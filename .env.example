# OpenAI-compatible LLM provider
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# auto 会自动探测；已知服务商能力时可设为 json_object，省去首次探测请求
LLM_RESPONSE_FORMAT=auto
# 推理模型输出额度耗尽时，从初始值逐次翻倍到最大值
LLM_SUMMARY_INITIAL_TOKENS=1500
LLM_SUMMARY_MAX_TOKENS=6000

# GitHub enrichment (optional but strongly recommended)
GITHUB_TOKEN=
GITHUB_PERIODS=daily,weekly,monthly
GITHUB_REQUEST_DELAY_SECONDS=2.0

# Feishu custom bot
FEISHU_WEBHOOK_URL=
FEISHU_SECRET=

# Hacker News UTC window
HN_LAG_DAYS=2
HN_MIN_POINTS=100
HN_TOP_N=25

# Notification layout
NOTIFY_MODE=digest
EXPANDED_PER_SECTION=5

# Optional runtime path overrides
# TREND_SIFT_DB_PATH=./data/trending.db
# TREND_SIFT_LOG_DIR=./logs
