# OpenAI-compatible LLM provider
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# auto probes provider capabilities; use json_object when supported to skip probing
LLM_RESPONSE_FORMAT=auto
# Double the output budget up to the cap when a reasoning model exhausts it
LLM_SUMMARY_INITIAL_TOKENS=1500
LLM_SUMMARY_MAX_TOKENS=6000
# Number of summaries generated in parallel (1 restores serial behavior)
LLM_SUMMARY_CONCURRENCY=5

# GitHub enrichment (optional but strongly recommended)
GITHUB_TOKEN=
GITHUB_PERIODS=daily,weekly,monthly
GITHUB_REQUEST_DELAY_SECONDS=2.0

# Feishu custom bot
FEISHU_WEBHOOK_URL=
FEISHU_SECRET=

# Hacker News UTC window
HN_LAG_DAYS=2
HN_MIN_POINTS=100
HN_TOP_N=25

# Notification layout
NOTIFY_MODE=digest
EXPANDED_PER_SECTION=5

# Optional runtime path overrides
TREND_SIFT_DB_PATH=./data/trending.db
TREND_SIFT_LOG_DIR=./logs

# Docker web host binding (container API listens on 8000)
TREND_SIFT_BIND=127.0.0.1
TREND_SIFT_PORT=8111

# Daily task inside the single-worker web service (restart after changing)
SCHEDULE_ENABLED=true
SCHEDULE_TIME=09:00
SCHEDULE_TIMEZONE=Asia/Shanghai
